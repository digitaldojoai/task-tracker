# Keep secrets and local environment files out of the build context entirely.
.env
*.env
!backend/.env.example

# Virtualenvs and caches (large, host-specific, never valid inside the image)
backend/venv/
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Not needed at runtime
.git/
.github/
docs/
frontend/
backend/tests/
README.md
AGENTS.md
Dockerfile
.dockerignore

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
